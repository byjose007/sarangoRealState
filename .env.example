# ---------------------------------------------------------------------------
# Vestra — environment variables
# Copy this file to `.env.local`. Every variable is optional: the template
# renders complete fallbacks when a key is missing.
# ---------------------------------------------------------------------------

# Canonical URL used for metadata, Open Graph, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Interactive maps. Leave empty to use the built-in static plan view.
# Google Maps Embed API key -> https://developers.google.com/maps/documentation/embed
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""
# Mapbox public token (used when no Google key is present and the
# NEXT_PUBLIC_MAP_PROVIDER is set to "mapbox")
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_MAP_PROVIDER="static" # static | google | mapbox

# Sales office contact details rendered across the site
NEXT_PUBLIC_CONTACT_PHONE="+1 (512) 555-0198"
NEXT_PUBLIC_WHATSAPP_NUMBER="15125550198"
NEXT_PUBLIC_CONTACT_EMAIL="hello@vestra.estate"

# ---------------------------------------------------------------------------
# Admin panel / CRM — backend, database and infra
# ---------------------------------------------------------------------------

# Postgres. In local dev this points at the `db` service from docker-compose
# (run `docker compose up db`, then `npx prisma migrate dev`). In production
# it's read by the `web` container against the same `db` service.
DATABASE_URL="postgresql://vestra:vestra@localhost:5432/vestra"

# Used by docker-compose.yml to provision the Postgres container. Change the
# password before deploying anywhere reachable.
POSTGRES_USER="vestra"
POSTGRES_PASSWORD="vestra"
POSTGRES_DB="vestra"

# Auth.js — generate with `npx auth secret` (or `openssl rand -base64 32`).
AUTH_SECRET=""
# Required off Vercel (self-hosted behind nginx) — Auth.js otherwise refuses
# to trust the Host header it gets from a reverse proxy.
AUTH_TRUST_HOST="true"

# Where uploaded property images/documents are written. Matches the volume
# mount in docker-compose.yml — leave as-is unless you change that mount.
UPLOADS_DIR="./uploads"
NEXT_PUBLIC_UPLOADS_BASE_URL="/uploads"

# SMTP — any provider works (Gmail, your own host, SendGrid/Mailgun in SMTP
# mode). Used for lead/stage-change notifications to agents.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vestra <notifications@vestra.estate>"

# Dev/demo only — DO NOT set this in production. `npm run db:seed` normally
# only seeds the real admin login + José Sarango (empty catalogue, ready for
# real listings via /admin/properties). Set to "1" (or use `npm run
# db:seed:demo`) to also load the template's fake second agent and ~100
# generated placeholder listings, for trying the UI out locally.
SEED_DEMO_DATA=""
